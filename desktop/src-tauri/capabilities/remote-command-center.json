{
  "identifier": "remote-command-center",
  "description": "What the deployed Command Center is allowed to do to its own windows. Deliberately small.",
  "local": false,
  "remote": {
    "urls": [
      "https://weare1mission.com",
      "https://weare1mission.com/*",
      "https://www.weare1mission.com",
      "https://www.weare1mission.com/*"
    ]
  },
  "windows": ["main", "companion"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-current-monitor",
    "core:window:allow-scale-factor",
    "core:event:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
