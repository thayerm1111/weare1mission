{
  "$schema": "https://schema.tauri.app/config/2.11.5",
  "productName": "Command Center XAUUSD",
  "version": "0.1.0",
  "identifier": "com.weare1mission.commandcenter",
  "build": {
    "frontendDist": "https://weare1mission.com",
    "devUrl": "https://weare1mission.com"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "companion",
        "url": "https://weare1mission.com/companion",
        "title": "THE BRAIN",
        "width": 360,
        "height": 232,
        "minWidth": 320,
        "minHeight": 200,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": false,
        "acceptFirstMouse": true,
        "visible": true,
        "focus": true
      },
      {
        "label": "main",
        "url": "https://weare1mission.com/command-center",
        "title": "COMMAND CENTER XAUUSD",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "capabilities": ["default", "remote-command-center"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/128x128.png", "icons/32x32.png"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
